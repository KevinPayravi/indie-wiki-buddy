{
  "name": "__MSG_extensionName__",
  "version": "4.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["alarms", "storage", "webRequest", "notifications", "scripting"],
  "icons": {
    "16": "images/logo-16.png",
    "32": "images/logo-32.png",
    "48": "images/logo-48.png",
    "64": "images/logo-64.png",
    "128": "images/logo-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/common-functions.js",
        "scripts/content-search-filtering.js",
        "scripts/content-banners.js",
        "favicons/*",
        "data/data.json"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ],
  "background": {
    "scripts": ["scripts/common-functions.js", "background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.fandom.com/*",
        "https://*.fextralife.com/*",
        "https://*.neoseeker.com/*",
        "https://breezewiki.com/*"
      ],
      "js": ["scripts/content-banners-importer.js"],
      "css": ["css/content-banners.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://breezewiki.com/*"],
      "js": ["scripts/content-breezewiki.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["scripts/content-search-filtering-importer.js"],
      "css": ["css/content-search-filtering.css"],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "pages/settings/index.html"
  },
  "host_permissions": [
    "https://*.fandom.com/*",
    "https://*.fextralife.com/*",
    "https://*.neoseeker.com/*",
    "https://breezewiki.com/*"
  ],
  "action": {
    "default_popup": "pages/popup/index.html",
    "default_icon": {
      "16": "images/logo-16.png",
      "32": "images/logo-32.png",
      "48": "images/logo-48.png",
      "64": "images/logo-64.png",
      "128": "images/logo-128.png"
    }
  },
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "{cb31ec5d-c49a-4e5a-b240-16c767444f62}",
      "strict_min_version": "128.0"
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },
  "manifest_version": 3
}
