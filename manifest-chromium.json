{
  "name": "__MSG_extensionName__",
  "version": "4.0.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "alarms",
    "storage",
    "webRequest",
    "notifications",
    "scripting"
  ],
  "default_locale": "en",
  "icons": {
    "16": "images/logo-16.png",
    "32": "images/logo-32.png",
    "48": "images/logo-48.png",
    "64": "images/logo-64.png",
    "128": "images/logo-128.png"
  },
  "action": {
    "default_popup": "pages/popup/index.html",
    "default_icon": {
      "16": "images/logo-16.png",
      "32": "images/logo-32.png",
      "48": "images/logo-48.png",
      "64": "images/logo-64.png",
      "128": "images/logo-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/common-functions.js",
        "scripts/content-search-filtering.js",
        "scripts/content-banners.js",
        "favicons/*",
        "data/data.json"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "js": [
        "scripts/content-search-filtering-importer.js"
      ],
      "css": [
        "css/content-search-filtering.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.fandom.com/*",
        "https://*.fextralife.com/*",
        "https://*.neoseeker.com/*",
        "https://breezewiki.com/*"
      ],
      "js": [
        "scripts/content-banners-importer.js"
      ],
      "css": [
        "css/content-banners.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://breezewiki.com/*"
      ],
      "js": [
        "scripts/content-breezewiki.js"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "https://*.fandom.com/*",
    "https://*.fextralife.com/*",
    "https://*.neoseeker.com/*",
    "https://breezewiki.com/*"
  ],
  "options_ui": {
    "page": "pages/settings/index.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "minimum_chrome_version": "131",
  "manifest_version": 3
}
